[Unit]
Description=JamurCare Aggregate Command
After=network.target
PartOf=jamurcare.target

[Service]
Type=oneshot
User=%u
WorkingDirectory=PROJECT_DIR_PLACEHOLDER
ExecStart=/usr/bin/php PROJECT_DIR_PLACEHOLDER/artisan monitoring:aggregate

Environment="PATH=/usr/local/bin:/usr/bin:/bin"

StandardOutput=journal
StandardError=journal
SyslogIdentifier=jamurcare-monitoring-aggregate
